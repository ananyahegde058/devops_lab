pipeline {
    agent any

    environment {
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
        APP_PORT = '5000'
    }

    stages {
        stage('Build') {
            steps {
                echo '=== Stage 1: Build & Dependency Resolution ==='
                echo 'Checking Python environment and installing dependencies...'
                sh '''
                python3 --version || python --version
                pip3 install -r requirements.txt || pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo '=== Stage 2: Automated Unit Testing ==='
                echo 'Running unit test suite using unittest...'
                sh 'python3 -m unittest discover -s . || python -m unittest discover -s .'
            }
        }

        stage('Deploy') {
            steps {
                echo '=== Stage 3: Application Deployment ==='
                echo "Deploying application to ${env.DEPLOY_DIR}..."
                sh '''
                mkdir -p ${DEPLOY_DIR}
                cp app.py ${DEPLOY_DIR}/
                cp requirements.txt ${DEPLOY_DIR}/
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo '=== Stage 4: Run Application Service ==='
                echo 'Launching deployed application in background...'
                sh '''
                if [ -f ${DEPLOY_DIR}/app.pid ]; then
                    kill -9 $(cat ${DEPLOY_DIR}/app.pid) || true
                fi
                nohup python3 ${DEPLOY_DIR}/app.py > ${DEPLOY_DIR}/app.log 2>&1 &
                echo $! > ${DEPLOY_DIR}/app.pid
                sleep 3
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo '=== Stage 5: End-to-End Verification ==='
                echo 'Executing verification tests against running deployment...'
                sh '''
                python3 test_app.py || python test_app.py
                curl -s http://localhost:5000/ || true
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution complete.'
            sh '''
            if [ -f ${DEPLOY_DIR}/app.pid ]; then
                echo "Cleaning up background application process..."
                kill -9 $(cat ${DEPLOY_DIR}/app.pid) || true
                rm -f ${DEPLOY_DIR}/app.pid
            fi
            '''
        }
        success {
            echo 'SUCCESS: All pipeline stages completed successfully!'
        }
        failure {
            echo 'FAILURE: Pipeline failed. Check console logs for error diagnostics.'
        }
    }
}
